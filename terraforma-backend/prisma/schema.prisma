// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // native: a máquina onde roda o build; rhel-openssl-3.0.x: as funções do Vercel (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  senha       String
  senhaVersao Int      @default(0) @map("senha_versao")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tokensRecuperacaoSenha TokenRecuperacaoSenha[]
  participacoes          ChatMembro[]
  mensagens              Message[]
  trilha                 TrilhaProgresso[]

  @@map("users")
}

model TokenRecuperacaoSenha {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_recuperacao_senha")
}

// Conversa entre membros (2 ou mais usuários).
model Chat {
  id        String   @id @default(cuid())
  titulo    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  membros   ChatMembro[]
  mensagens Message[]

  @@index([updatedAt])
  @@map("chats")
}

// Quem participa de cada chat. Só membros leem e escrevem.
model ChatMembro {
  chatId    String   @map("chat_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_membros")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String   @map("chat_id")
  // null quando o autor apagou a conta: a mensagem fica, sem nome.
  autorId   String?  @map("autor_id")
  conteudo  String
  // true quando a moderação automática removeu algum trecho.
  moderada  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  chat  Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  autor User? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
  @@index([autorId])
  @@map("messages")
}

// Progresso da trilha: uma linha por atividade concluída (aula, quiz ou "Na prática").
// capitulo/indice são a posição do círculo na trilha (a chave "c-i" do front).
// Nada regride: a data fica a primeira, os acertos ficam o melhor resultado.
model TrilhaProgresso {
  userId      String   @map("user_id")
  capitulo    Int
  indice      Int
  concluidaEm DateTime @map("concluida_em")
  // só no quiz: melhor número de acertos de primeira e total de perguntas
  acertos     Int?
  total       Int?
  // só no "Na prática": índice da opção escolhida
  escolha     Int?
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, capitulo, indice])
  @@map("trilha_progresso")
}
