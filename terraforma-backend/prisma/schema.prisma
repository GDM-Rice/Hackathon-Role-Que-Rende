// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js" //Mudamos para o legacy mode para evitar problemas de erro de caminho relativo no Windows, mas você pode mudar para o novo modo se quiser
  // output   = "../generated/prisma" 
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id
  username  String 
  email     String @unique
  senha     String @map("senha")
  senhaVersao Int @default(0) @map("senha_versao")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tokensRecuperacaoSenha TokenRecuperacaoSenha[]

  @@map("Users")
}

model TokenRecuperacaoSenha {
  id        String      @id
  UserId String      @map("usuario_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())

  usuario User @relation(fields: [UserId], references: [id], onDelete: Cascade)

  @@index([UserId])
  @@map("tokens_recuperacao_senha")
}