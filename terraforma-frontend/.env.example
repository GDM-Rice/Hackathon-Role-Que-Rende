# URL do backend. Vazio = o front usa as rotas de exemplo em /api (memória, só para desenvolvimento).
NEXT_PUBLIC_API_URL=

# URL do back-end NestJS (conta, senha, conversas e trilha). Vazio = http://localhost:3001
# No Vercel: a URL do projeto do back (ex.: https://terraforma-api.vercel.app). Mudou? Faça um novo deploy do front.
NEXT_PUBLIC_BACKEND_URL=
