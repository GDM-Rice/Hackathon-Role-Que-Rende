PORT=3001

# Local do arquivo da database
DATABASE_URL="file:./dev.db"

# Você pode gerar uma chave de segurança aqui: https://ferramentas.qmix.com.br/gerador-de-caracteres
JWT_SECRET = "SUA_CHAVE_DE_SEGURANÇA"

# URL do front-end
FRONTEND_URL="http://localhost:3000"

# E-mail (opcional em dev: sem SMTP_HOST o link de recuperação aparece no console do Nest)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Terraforma <no-reply@seudominio.com>"