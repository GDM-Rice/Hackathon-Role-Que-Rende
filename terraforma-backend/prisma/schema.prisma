// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js" //Mudamos para o legacy mode para evitar problemas de erro de caminho relativo no Windows, mas você pode mudar para o novo modo se quiser
  // output   = "../generated/prisma" 
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id
  username  String 
  email     String @unique
  senha     String 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("Users")
}