# Porta do back-end (o front usa 3000, então o back NÃO pode usar 3000)
PORT=3001

# Endereço do front-end (usado no CORS e no link de recuperação de senha)
FRONTEND_URL=http://localhost:3000

# (Opcional) Várias origens permitidas no CORS, separadas por vírgula.
# Se vazio, vale só o FRONTEND_URL.
CORS_ORIGINS=

# Conexão com o PostgreSQL (formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public)
# Esta URL bate com o docker-compose.yml deste projeto (porta 5433).
# Se usar um PostgreSQL instalado na máquina, ajuste usuário, senha e porta (padrão 5432).
DATABASE_URL="postgresql://terraforma:terraforma@localhost:5433/terraforma?schema=public"

# Gere uma chave aleatória com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A aplicação se recusa a subir se esta variável estiver vazia ou curta demais.
JWT_SECRET="Sua-Senha"

# E-mail (opcional em dev: sem SMTP_HOST o link de recuperação aparece no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Terraforma <nao-responda@exemplo.com>"
