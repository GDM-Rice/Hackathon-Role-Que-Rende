# Copie para .env.local e ajuste (o .env.local não vai para o Git).

# Supabase (contas e backup). Dashboard > Project Settings > API.
# Use a chave PÚBLICA (publishable, "sb_publishable_..." ou a antiga "anon").
# NUNCA coloque a chave secreta/service_role aqui: tudo com VITE_ vai para o navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Endereço do backend da Luneta no BUILD, quando a API estiver em outro domínio.
# Em desenvolvimento deixe vazio: o Vite encaminha /api para a porta 3001.
VITE_API_URL=

# Backend (npm run backend). Todos opcionais.
# PORT=3001
# CORS_ORIGEM=http://localhost:5173
# SEMEAR=0
# MODERACAO_TERMOS_EXTRAS=
