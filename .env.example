# Copie para .env.local e ajuste (o .env.local não vai para o Git).

# Endereço do backend no BUILD, quando a API estiver em outro domínio.
# Em desenvolvimento deixe vazio: o Vite encaminha /api para a porta 3001.
VITE_API_URL=

# Backend (npm run backend). Todos opcionais.
# PORT=3001
# CORS_ORIGEM=http://localhost:5173
# SEMEAR=0
# MODERACAO_TERMOS_EXTRAS=
